# Local development config. Read by the backend and by ./manage.sh, and by
# neither in production: the deployed stacks get their environment directly.
#
# Precedence, as both readers apply it: real environment variables first, then
# .env, then this file. A personal .env always wins over .env.dev.
#
# Not read by Next.js, which loads .env / .env.local / .env.development. The
# API_URL and NEXT_PUBLIC_API_URL variables in .env.example belong in one of
# those, or in the surrounding environment.
#
# Anything left out here falls back to the default built into the app, so this
# only needs the variables a local run actually changes.

# Runtime profile: development | qa | production. development seeds the
# admin@mail.com login and fixes the 2FA code at 1234; qa and production
# never seed.
NODE_ENV=development

# PostgreSQL. Same value the app defaults to, spelled out so there's an
# obvious place to change it. Docker compose publishes its own Postgres on
# 5433 if you'd rather point a native run at that one.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/template-db?sslmode=disable"

# The DB-backed integration tests use a separate database, so they never touch
# the one above. Nothing in the app reads this; it is for the test suite. Left
# unset, those 12 tests skip and the 27 unit tests still run.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:5432/template-db-test?sslmode=disable"

# Email verification gate on login and /api/me. Off here so a fresh signup can
# sign in without clicking a link — with no SMTP configured the mail only ever
# reaches the log, so there's nothing convenient to click.
EMAIL_VERIFICATION_REQUIRED=false

# Where verification and password-reset links point.
FRONTEND_URL="http://localhost:3000"

# Set SMTP_HOST to send real mail. Left unset, the mailer logs each message
# instead, which is why dev needs no mail server. Inside the compose stack
# Mailpit is reachable as mailpit on port 1025.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="you@example.com"
# SMTP_PASS=""

# Required in production, and refused below 32 bytes. Deliberately absent here:
# development falls back to a dev-only secret and logs a warning about it, so
# there's no placeholder secret sitting in a file to be promoted by accident.
# JWT_SECRET=""
