# Backend — copy to .env and adjust. This documents every variable the app
# reads; development has working defaults for all of them.

# Runtime profile: development | qa | production.
# development seeds a known admin login (admin@mail.com); qa/prod never do.
NODE_ENV=development

# PostgreSQL connection. Has a working dev default; set it in production.
# Tables apply automatically on start.
DATABASE_URL="postgres://user:password@localhost:5432/template-db?sslmode=disable"

# Authentication — REQUIRED in production (the server refuses to boot
# without it); falls back to a dev-only secret otherwise. Must be at least
# 32 bytes either way, or the app refuses to start.
JWT_SECRET="your-secret-key-here-change-in-production"

# Listen port for the API (the Next.js frontend lives on 3000).
PORT=8080

# email
MAIL_FROM="tom.tran@email.com"
MAX_ATTEMPTS=2
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="your-smtp-password"

# email verification gate (login + /api/me). Leave unset to require it.
EMAIL_VERIFICATION_REQUIRED=false

# Used in verification / reset links sent by email.
FRONTEND_URL="http://localhost:3000"

# Frontend: where the Next.js server proxies /api/* to (server-side — the
# browser never talks to the API directly). Only set if the API lives
# somewhere other than http://localhost:8080.
# API_URL="http://api.internal:8080"
#
# Split-domain deployment that calls the API from the browser directly?
# Set NEXT_PUBLIC_API_URL instead (build-time, inlined into the client bundle).
# The API sets no CORS headers, so it has to allow this origin first.
# NEXT_PUBLIC_API_URL="https://api.example.com"
