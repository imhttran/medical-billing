# Node / Next.js (frontend/)
node_modules/
.next/
tsconfig.tsbuildinfo

# Gradle / JVM (backend/)
build/
.gradle/
bin/
# The Gradle wrapper jar is committed, so it must survive the rules above.
!backend/gradle/wrapper/gradle-wrapper.jar

# Service pid files (manage.sh)
*.pid

# JVM crash artefacts. A dying JVM writes both of these into its working
# directory, which is the repo root for the Kotlin language server and backend/
# for a Gradle daemon.
hs_err_pid*.log
replay_pid*.log

# Env config: the two shipped templates are tracked, everything else is yours.
# A root .env — and any other .env.* you add — stays personal and overrides
# whatever the tracked files set.
.env
.env.*
!.env.example
!.env.dev

# macOS
.DS_Store

# Playwright MCP artifacts
.playwright-mcp/
